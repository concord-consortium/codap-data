20%20%3Ch1%3EWelcome%20to%20Projectile%20Data%20Lab%20%2B%20CODAP%3C%2Fh1%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3EHere%2C%20you%20can%20design%20and%20carry%20out%20experiments%20using%20the%20PhET%20simulation%2C%20and%20analyze%20the%20data%20using%20CODAP.%20%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3ESome%20tips%20to%20help%20you%20get%20started%3A%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Col%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3ESelect%20the%20variables%20that%20you%20are%20interested%20in%20collecting%20from%20the%20panel%20next%20to%20the%20PhET%20simulation.%20As%20you%20launch%20projectiles%20in%20the%20simulation%2C%20the%20corresponding%20measurements%20will%20populate%20in%20the%20Projectile%20Data%20table.%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3ETo%20plot%20the%20distribution%20of%20a%20measurement%20variable%2C%20drag%20the%20heading%20of%20the%20variable%20in%20the%20Projectile%20Data%20table%20to%20the%20x-axis%20of%20the%20plot%20in%20the%20Projectile%20Graph%20window.%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3ETo%20compare%20the%20distribution%20of%20a%20measurement%20variable%20for%20different%20setups%2C%20drag%20the%20heading%20of%20the%20setup%20variable%20in%20the%20Projectile%20Data%20table%20to%20the%20y-axis%20of%20the%20plot%20in%20the%20Projectile%20Graph%20window.%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cli%3ETo%20compute%20the%20statistics%20of%20a%20measurement%20variable%2C%20you%20can%20click%20the%20Measure%20icon%20(as%20indicated%20by%20the%20ruler%20symbol%20next%20to%20the%20Projectile%20Graph%20window)%2C%20check%20%E2%80%9CShow%20Measure%20Labels%E2%80%9D%2C%20and%20then%20check%20Mean%2C%20Standard%20Deviation%2C%20or%20Standard%20Error%20for%20CODAP%20to%20report%20the%20statistics%20of%20interest.%3C%2Fli%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fol%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cp%3EWe%20hope%20you%20enjoy%20exploring%20and%20analyzing%20your%20data%20with%20Projectile%20Data%20Lab%20%2B%20CODAP.%20Happy%20experimenting!%3C%2Fp%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdiv%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fbody%3E%0A%20%20%20%20%20%20%20%20%20%20%3C%2Fhtml%3E%0A%20%20%20%20%20%20%20%20","name":"simInfo","userSetTitle":false,"cannotClose":true},"layout":{"width":300,"height":350,"left":1250,"top":210,"zIndex":105,"isVisible":true,"right":1550,"bottom":560},"savedHeight":null}],"contexts":[{"type":"DG.DataContext","document":1,"guid":3,"id":3,"flexibleGroupingChangeFlag":false,"name":"simulation-data-context","title":"Simulation Data","collections":[{"areParentChildLinksConfigured":false,"attrs":[{"name":"Data index","type":"numeric","title":"Data index","cid":"id:C9VtUWo-iknkqx2g","description":"The total number of rows of data collected from the simulation. Resets to 1 when all data is deleted.","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":false,"guid":5,"id":5,"precision":2,"unit":null},{"name":"Field","type":"categorical","title":"Field","cid":"id:vwhJAkgjiWHhV_5l","description":"Field identifier","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":false,"renameable":true,"deleteable":false,"guid":6,"id":6,"precision":2,"unit":null},{"name":"Screen identifier","type":"categorical","title":"Screen identifier","cid":"id:JGaz-sscs3-2Y9NR","description":"Unique identifier for the screen the projectile is on","blockDisplayOfEmptyCategories":true,"editable":true,"hidden":true,"renameable":true,"deleteable":false,"guid":7,"id":7,"precision":2,"unit":null},{"name":"Launcher","type":"categorical","ti